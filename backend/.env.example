NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27018/buit_papers?replicaSet=testset
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
SITE_URL=http://localhost:5173
API_URL=http://localhost:4000
# Generate independent values with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ANALYTICS_SECRET=
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
TRUST_PROXY=0
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ATLAS_SEARCH_ENABLED=false
CF_ORIGIN_SECRET=
CONTACT_EMAIL=
# Outgoing mail. Preferred: a Brevo API key (works on hosts that block SMTP, e.g. Render's free plan).
# MAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
# Or SMTP. For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-letter App Password>. Leave SMTP_HOST empty in development to print mails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Gets an email when a student creates a contributor account (defaults to CONTACT_EMAIL).
ADMIN_NOTIFY_EMAIL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
